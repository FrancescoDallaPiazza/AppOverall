# Le due chiavi del progetto Supabase che ospitera AppOverall (decisione del 17
# settembre 2026: quello di AppFormazione). La anon key sta nel client per
# progettazione e da sola non apre niente: lo decidono le policy. La service_role key
# qui non entra mai.
VITE_SUPABASE_URL="https://<progetto>.supabase.co"
VITE_SUPABASE_ANON_KEY="la-anon-key"
